# Copy this file to .env and fill in the values. Git ignores .env.
# Both values end up in the page HTML, as these services intend for browser forms.

# Web3Forms access key for the contact and footer forms, created with
# sales@winapps.co.in. Find it at https://app.web3forms.com.
# Without it these forms open the visitor's email app.
PUBLIC_WEB3FORMS_KEY=

# ID of the Tally job application form: the last part of its share link,
# tally.so/r/<id>. Without it role pages ask applicants to email HR.
PUBLIC_TALLY_CAREERS_FORM_ID=

# Optional: Plausible analytics domain, for example www.winapps.co.in.
PUBLIC_PLAUSIBLE_DOMAIN=
