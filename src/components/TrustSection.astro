---
// "Why teams trust us": the five commitments and the live clocks, in the
// site's one dark panel (#0E2E31, orange top rule).
import Clocks from "./Clocks.astro";
import { TRUST, headingText } from "../data/copy";

interface Props {
  /** id of the section's h2 (aria-labelledby target). */
  id?: string;
  headingLevel?: "h2";
}
const { id = "trust-title", headingLevel: H = "h2" } = Astro.props;
---
<section class="section trust" aria-labelledby={id}>
  <div class="container">
    <div class="panel panel--dark on-dark trust__panel">
      <div class="trust__main">
        <p class="eyebrow">{TRUST.eyebrow}</p>
        <H id={id} class="h2 trust__title">{headingText(TRUST)}</H>
        <p class="lead trust__intro">{TRUST.intro}</p>
        <ul class="trust__list">
          {TRUST.commitments.map((c, i) => (
            <li class="trust__item">
              <span class="card__num" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              <h3 class="h4">{c.title}</h3>
              <p class="text-2">{c.text}</p>
            </li>
          ))}
        </ul>
      </div>
      <div class="trust__clocks">
        <Clocks />
      </div>
    </div>
  </div>
</section>

<style>
  .trust__panel {
    display: grid;
    gap: 48px;
    padding: clamp(28px, 4.4vw, 72px);
  }
  @media (min-width: 1100px) {
    .trust__panel { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(40px, 5vw, 80px); }
    .trust__clocks { padding-top: 96px; }
  }
  .trust__main > .eyebrow { margin-bottom: 22px; }
  .trust__intro { margin-top: 20px; max-width: 56ch; }
  .trust__list {
    display: grid;
    gap: 0 32px;
    margin: 48px 0 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 640px) {
    .trust__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  .trust__item {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px 0 28px;
    border-top: 1px solid var(--overlay-rule);
  }
  .trust__item .card__num { color: var(--accent); }
  .trust__item p { font-size: 15px; line-height: 1.55; }
  /* On the dark panel: the rule and number light up in logo yellow. */
  .trust__item { transition: border-color 0.2s, transform 0.25s var(--ease); }
  .trust__item .card__num { transition: color 0.2s; }
  .trust__item:hover { border-top-color: var(--yellow); box-shadow: inset 0 1px 0 var(--yellow); }
  .trust__item:hover .card__num { color: var(--yellow); }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .trust__item:hover { transform: translateY(-3px); }
  }
</style>
