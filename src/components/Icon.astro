---
// Inline SVG icons. "arrow", "search", "menu", "close" and "whatsapp" are the
// design's own marks (square line caps); the rest are simple line icons in the
// same weight. Decorative by default (aria-hidden); pass `label` to name one.
// `size` is the icon's width; height follows the viewBox.
export type IconName =
  | "arrow"
  | "arrow-up-right"
  | "search"
  | "menu"
  | "close"
  | "whatsapp"
  | "check"
  | "plus"
  | "chevron-down"
  | "mail"
  | "phone";

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  label?: string;
}
const { name, size = 18, class: className = "", label } = Astro.props;

// WhatsApp glyph copied verbatim from design-export/Main.dc.html.
const WHATSAPP =
  "M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.39-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.08 1.76-.72 2.01-1.42.25-.7.25-1.29.17-1.42-.07-.13-.27-.2-.57-.35zM12.04 21.5h-.01a9.45 9.45 0 0 1-4.82-1.32l-.35-.21-3.58.94.96-3.49-.23-.36a9.43 9.43 0 0 1-1.45-5.03c0-5.22 4.25-9.47 9.48-9.47 2.53 0 4.91.99 6.7 2.78a9.4 9.4 0 0 1 2.77 6.7c0 5.22-4.25 9.46-9.47 9.46zm8.06-17.53A11.33 11.33 0 0 0 12.04.63C5.76.63.65 5.74.65 12.02c0 2.01.52 3.97 1.52 5.69L.55 23.6l6.04-1.58a11.36 11.36 0 0 0 5.44 1.39h.01c6.28 0 11.39-5.11 11.39-11.39 0-3.04-1.18-5.9-3.33-8.05z";

const ICONS: Record<IconName, { w: number; h: number; body: string; filled?: boolean }> = {
  arrow: { w: 18, h: 14, body: '<path d="M1 7h15M10 1l6 6-6 6"/>' },
  "arrow-up-right": { w: 16, h: 16, body: '<path d="M4 12L12 4M5.5 4H12v6.5"/>' },
  search: { w: 24, h: 24, body: '<circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5L21 21"/>' },
  menu: { w: 18, h: 12, body: '<path d="M0 1h18M0 6h18M0 11h18"/>' },
  close: { w: 14, h: 14, body: '<path d="M1 1l12 12M13 1L1 13"/>' },
  whatsapp: { w: 24, h: 24, filled: true, body: `<path fill="#1FAF38" d="${WHATSAPP}"/>` },
  check: { w: 16, h: 16, body: '<path d="M2.5 8.5l3.5 3.5 7.5-8"/>' },
  plus: { w: 16, h: 16, body: '<path d="M8 1.5v13M1.5 8h13"/>' },
  "chevron-down": { w: 14, h: 9, body: '<path d="M1 1l6 6 6-6"/>' },
  mail: { w: 24, h: 24, body: '<path d="M2.5 5h19v14h-19z"/><path d="M2.5 5.5L12 13l9.5-7.5"/>' },
  phone: {
    w: 24,
    h: 24,
    body: '<path d="M21 16.5v3.8c0 .5-.4.9-.9.9C10.6 21.2 2.8 13.4 2.8 3.9c0-.5.4-.9.9-.9h3.8l1.6 4.4-2.3 1.7c1.2 2.7 3.4 4.9 6.1 6.1l1.7-2.3 4.4 1.6z"/>',
  },
};

const icon = ICONS[name];
const width = size;
const height = Math.round((size * icon.h) / icon.w);
const paint = icon.filled ? "" : 'fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square"';
const a11y = label ? `role="img" aria-label="${label}"` : 'aria-hidden="true"';
const svg = `<svg class="icon icon-${name}${className ? " " + className : ""}" width="${width}" height="${height}" viewBox="0 0 ${icon.w} ${icon.h}" ${paint} ${a11y} focusable="false">${icon.body}</svg>`;
---
<Fragment set:html={svg} />
