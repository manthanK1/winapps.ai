---
// Closing call to action on every page: the design's contact band (h2 left,
// orange button right) with V1's copy and all four routes: call, email,
// WhatsApp, phone.
import Icon from "./Icon.astro";
import { CTA } from "../data/copy";
import { SITE } from "../data/site";
import { href } from "../lib/url";

interface Props {
  title?: string;
  text?: string;
  id?: string;
}
const { title = CTA.title, text = CTA.text, id = "cta-title" } = Astro.props;
---
<section class="section cta-band" aria-labelledby={id}>
  <div class="container">
    <div class="cta-band__row">
      <div class="cta-band__text veil">
        <h2 id={id} class="cta-band__title">{title}</h2>
        <p class="lead cta-band__lead">{text}</p>
      </div>
      <div class="cta-band__actions">
        <a href={href(SITE.bookingPath)} class="btn btn--accent">{CTA.primary} <Icon name="arrow" size={18} class="arrow" /></a>
        <a href={`mailto:${SITE.email}`} class="btn btn--outline">{CTA.email} <Icon name="arrow" size={18} class="arrow" /></a>
      </div>
    </div>
    <p class="cta-band__alt veil">
      {CTA.alt.before} <a class="link" href={SITE.whatsappHref} target="_blank" rel="noopener">{CTA.alt.whatsapp}</a>{CTA.alt.middle}{" "}
      <a class="link" href={SITE.phoneHref}>{SITE.phone}</a>{CTA.alt.after}
    </p>
  </div>
</section>

<style>
  .cta-band__row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 32px 40px; }
  .cta-band__text { max-width: 820px; }
  .cta-band__title {
    font-size: clamp(36px, 4.6vw, 68px);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }
  .cta-band__lead { margin-top: 20px; max-width: 60ch; }
  .cta-band__actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .cta-band__alt { display: inline-block; margin-top: 28px; font-size: 15px; color: var(--ink-2); }
  @media (max-width: 520px) {
    .cta-band__actions, .cta-band__actions .btn { width: 100%; }
  }
</style>
