---
// Site header, as in the design: animated logo, nav links, WhatsApp (square
// outline), Book a call (solid #134F53), search, and the black MENU button
// that opens the full-screen dark-teal overlay. Every menu and submenu link
// is a plain <a href> in the HTML, so crawlers see them all.
//
// Widths: nav links show from 900px (MENU still holds everything); all labels
// show from 1140px, and 900–1139 sheds the WhatsApp label (then, below 1000,
// the MENU label). ≤640px is one row: logo · WhatsApp (icon) · Book a call
// (text) · MENU; ≤400px MENU is icon-only. Every control stays ≥ 44×44.
import Icon from "./Icon.astro";
import { INSIGHTS, MENU_LINKS, NAV, SITE } from "../data/site";
import { getCourses, getIndustries, getServices, getTracks } from "../lib/content";
import { coursePath } from "../lib/schema";
import { href, isActive } from "../lib/url";

const current = Astro.url.pathname;
const services = await getServices();
const industries = await getIndustries();
const tracks = await getTracks();
const courses = await getCourses();
const firstSentence = (s: string) => s.split(". ")[0].replace(/\.$/, "") + ".";

const menuActive = (menu: string) =>
  menu === "what-we-do"
    ? isActive(current, "/services/") || isActive(current, "/industries/")
    : menu === "training"
      ? isActive(current, "/training/")
      : INSIGHTS.some((i) => isActive(current, i.href));
---
<header class="site-header" data-site-header>
  <a href={href("/")} class="site-logo" aria-label={`${SITE.name} home`}>
    <picture>
      <source srcset={href("/brand/winapps-logo-still.webp")} type="image/webp" media="(prefers-reduced-motion: reduce)" />
      <img src={href("/brand/winapps-logo.gif")} alt={SITE.name} width="257" height="287" decoding="async" />
    </picture>
  </a>

  <nav class="site-nav" aria-label="Main">
    <ul class="list-reset site-nav__list">
      {NAV.map((item) =>
        "menu" in item ? (
          <li data-menu>
            <button
              type="button"
              class="site-nav__link"
              aria-expanded="false"
              aria-controls={`menu-${item.menu}`}
              data-active={menuActive(item.menu) ? "" : undefined}
              data-menu-trigger
            >
              {item.label}
              <Icon name="chevron-down" size={11} class="site-nav__chev" />
            </button>
            <div id={`menu-${item.menu}`} class="mega" hidden data-menu-panel>
              <div class="mega__inner">
                {item.menu === "what-we-do" && (
                  <div class="mega__grid mega__grid--wwd">
                    <div>
                      <p class="eyebrow">Services</p>
                      <ul class="list-reset mega__list">
                        {services.map((s) => (
                          <li>
                            <a class="mega__item" href={href(`/services/${s.id}/`)} aria-current={isActive(current, `/services/${s.id}/`) ? "page" : undefined}>
                              <span class="mega__title">{s.data.title}</span>
                              <span class="mega__sub">{firstSentence(s.data.summary)}</span>
                            </a>
                          </li>
                        ))}
                      </ul>
                      <a class="link-u" href={href("/services/")}>All services <Icon name="arrow" size={16} /></a>
                    </div>
                    <div>
                      <p class="eyebrow">Industries</p>
                      <ul class="list-reset mega__list mega__list--plain">
                        {industries.map((i) => (
                          <li><a class="mega__item mega__item--plain" href={href(`/industries/#${i.id}`)}>{i.data.name}</a></li>
                        ))}
                      </ul>
                      <a class="link-u" href={href("/industries/")}>All industries <Icon name="arrow" size={16} /></a>
                    </div>
                  </div>
                )}
                {item.menu === "training" && (
                  <div>
                    <div class="mega__grid mega__grid--training">
                      {tracks.map((t) => (
                        <div>
                          <p class="eyebrow"><a class="mega__track" href={href(`/training/#${t.id}`)}>{t.data.name}</a></p>
                          <ul class="list-reset mega__list mega__list--plain">
                            {courses.filter((c) => c.track.id === t.id).map((c) => (
                              <li>
                                <a class="mega__item mega__item--plain" href={href(coursePath(c.id))} aria-current={isActive(current, coursePath(c.id)) ? "page" : undefined}>{c.name}</a>
                              </li>
                            ))}
                          </ul>
                        </div>
                      ))}
                    </div>
                    <a class="link-u" href={href("/training/")}>All training <Icon name="arrow" size={16} /></a>
                  </div>
                )}
                {item.menu === "insights" && (
                  <ul class="list-reset mega__grid mega__grid--insights">
                    {INSIGHTS.map((i) => (
                      <li>
                        <a class="mega__item" href={href(i.href)} aria-current={isActive(current, i.href) ? "page" : undefined}>
                          <span class="mega__title">{i.label}</span>
                          <span class="mega__sub">{i.text}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </div>
          </li>
        ) : (
          <li>
            <a class="site-nav__link" href={href(item.href)} aria-current={isActive(current, item.href) ? "page" : undefined}>{item.label}</a>
          </li>
        )
      )}
    </ul>
  </nav>

  <div class="site-actions">
    <a href={SITE.whatsappHref} target="_blank" rel="noopener" class="btn btn--outline btn--sm hdr-wa" aria-label="Chat on WhatsApp">
      <Icon name="whatsapp" size={18} class="wa-icon" /><span class="hdr-wa__label">WhatsApp</span>
    </a>
    <a href={href(SITE.bookingPath)} class="btn btn--primary btn--sm hdr-book">
      Book a call <Icon name="arrow" size={14} class="arrow hdr-book__arrow" />
    </a>
    <button type="button" class="hdr-icon hdr-search" aria-label="Search" aria-haspopup="dialog" aria-controls="site-search" data-search-open>
      <Icon name="search" size={18} />
    </button>
    <button type="button" class="hdr-menu" aria-label="Menu" aria-haspopup="dialog" aria-controls="site-menu" data-menu-open>
      <span class="hdr-menu__label" aria-hidden="true">MENU</span>
      <Icon name="menu" size={18} />
    </button>
  </div>
</header>

<!-- MENU overlay: V1's expanded drawer. A modal <dialog> traps focus and closes on Escape. -->
<dialog id="site-menu" class="menu-overlay on-dark" aria-label="Menu">
  <div class="menu-overlay__bar">
    <a href={href("/")} class="menu-overlay__mark" aria-label={`${SITE.name} home`}><span aria-hidden="true"></span>WINAPPS</a>
    <button type="button" class="menu-overlay__close" data-menu-close>
      CLOSE <Icon name="close" size={14} />
    </button>
  </div>
  <div class="menu-overlay__body">
    <nav class="menu-overlay__main" aria-label="Site links">
      <ul class="list-reset">
        {MENU_LINKS.map((l) => (
          <li>
            <a href={href(l.href)} class:list={["menu-overlay__big", { "is-contact": l.href === "/contact/" }]} aria-current={isActive(current, l.href) ? "page" : undefined}>{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="menu-overlay__side">
      <details class="menu-group" open data-menu-group>
        <summary>Services <Icon name="plus" size={14} class="menu-group__icon" /></summary>
        <ul class="list-reset">
          {services.map((s) => <li><a href={href(`/services/${s.id}/`)} aria-current={isActive(current, `/services/${s.id}/`) ? "page" : undefined}>{s.data.title}</a></li>)}
          <li><a href={href("/services/")} class="menu-group__all">All services</a></li>
        </ul>
      </details>
      <details class="menu-group" open data-menu-group>
        <summary>Training <Icon name="plus" size={14} class="menu-group__icon" /></summary>
        <ul class="list-reset">
          {tracks.map((t) => <li><a href={href(`/training/#${t.id}`)}>{t.data.name}</a></li>)}
          <li><a href={href("/training/")} class="menu-group__all" aria-current={current === href("/training/") ? "page" : undefined}>All courses</a></li>
        </ul>
      </details>
      <div class="menu-overlay__contact">
        <div class="menu-overlay__ctas">
          <a href={href(SITE.bookingPath)} class="btn btn--accent">Book a 30-min intro call <Icon name="arrow" size={16} class="arrow" /></a>
          <a href={SITE.whatsappHref} target="_blank" rel="noopener" class="btn btn--ghost-light"><Icon name="whatsapp" size={18} class="wa-icon" /> WhatsApp</a>
        </div>
        <p class="menu-overlay__note">Reply within 1 business day · NDA before the first call</p>
        <p class="menu-overlay__direct">
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
          <a href={SITE.phoneHref}>{SITE.phone}</a>
        </p>
      </div>
    </div>
  </div>
</dialog>

<!-- Search: a small client-side index of every page (/search.json), loaded on first open. -->
<dialog id="site-search" class="search-dialog" aria-label="Search the site">
  <form class="search-dialog__form" role="search" data-search-form>
    <label for="site-search-q" class="sr-only">Search the site</label>
    <Icon name="search" size={20} class="search-dialog__glass" />
    <input id="site-search-q" name="q" type="search" class="search-dialog__input" placeholder="Search services, work, courses, guides…" autocomplete="off" spellcheck="false" />
    <button type="button" class="hdr-icon" aria-label="Close search" data-search-close><Icon name="close" size={14} /></button>
  </form>
  <p class="search-dialog__status" role="status" aria-live="polite" data-search-status></p>
  <ul class="list-reset search-dialog__results" data-search-results></ul>
</dialog>

<style>
  /* ---- Bar --------------------------------------------------------------- */
  .site-header {
    position: absolute;
    inset: 0 0 auto 0;
    z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: var(--header-h);
    padding: 0 var(--gutter);
    border-bottom: 1px solid var(--rule);
    background: var(--header-bg);
  }
  .site-logo {
    display: flex;
    align-items: flex-start;
    flex: none;
    height: var(--header-h);
    padding-top: 6px;
    overflow: hidden;
    text-decoration: none;
  }
  .site-logo img { display: block; height: 82px; width: auto; max-width: none; }

  /* ---- Nav ----------------------------------------------------------------- */
  .site-nav { display: none; }
  @media (min-width: 900px) {
    .site-nav { display: block; }
  }
  .site-nav__list { display: flex; align-items: center; gap: clamp(10px, 4.2vw - 28px, 36px); }
  .site-nav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink);
    font: 500 14px/1 var(--font-body);
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    isolation: isolate;
    transition: color 0.2s, transform 0.25s var(--ease);
  }
  /* Hover: a logo-yellow block pops in behind the label (ink text keeps contrast). */
  .site-nav__link::before {
    content: "";
    position: absolute;
    inset: 5px -10px;
    z-index: -1;
    background: var(--yellow);
    opacity: 0;
    transform: scale(0.85);
    transition: opacity 0.2s, transform 0.25s var(--ease), box-shadow 0.25s;
  }
  .site-nav__link:hover, .site-nav__link[aria-expanded="true"], .site-nav__link:focus-visible { color: var(--ink); }
  .site-nav__link:hover::before, .site-nav__link[aria-expanded="true"]::before, .site-nav__link:focus-visible::before {
    opacity: 1;
    transform: scale(1);
    box-shadow: var(--lift-shadow);
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .site-nav__link:hover { transform: translateY(-2px); }
  }
  .site-nav__link[aria-current="page"]::after,
  .site-nav__link[data-active]::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 6px;
    height: 2px;
    background: var(--accent);
  }
  .site-nav__link :global(.site-nav__chev) { transition: transform 0.25s var(--ease); }
  .site-nav__link[aria-expanded="true"] :global(.site-nav__chev) { transform: rotate(180deg); }

  /* Mega panels: full width under the bar, sharp, 1px rules. */
  .mega {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    z-index: 30;
    border-top: 1px solid var(--rule);
    border-bottom: 2px solid var(--ink);
    background: #fff;
  }
  .mega::before { content: ""; position: absolute; left: 0; right: 0; bottom: 100%; height: 16px; }
  .mega__inner { max-width: var(--maxw); margin: 0 auto; padding: 36px var(--gutter) 40px; }
  .mega__grid { display: grid; gap: 40px; margin-bottom: 20px; }
  .mega__grid--wwd { grid-template-columns: 1.6fr 1fr; }
  .mega__grid--wwd > div:first-child .mega__list { grid-template-columns: 1fr 1fr; }
  .mega__grid--training { grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 28px; }
  .mega__grid--insights { grid-template-columns: repeat(2, minmax(0, 360px)); margin-bottom: 0; }
  .mega .eyebrow { margin-bottom: 14px; }
  .mega__track { color: inherit; text-decoration: none; }
  .mega__track:hover { text-decoration: underline; text-underline-offset: 3px; }
  .mega__list { display: grid; gap: 2px 24px; margin-bottom: 16px; }
  .mega__item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-height: 44px;
    padding: 10px 0;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    transition: background-color 0.2s, box-shadow 0.2s, padding 0.25s var(--ease);
  }
  .mega__item--plain { justify-content: center; padding: 8px 0; font-size: 14px; font-weight: 500; }
  .mega__title { font-size: 15px; font-weight: 600; }
  .mega__sub { font-size: 13px; color: var(--muted); line-height: 1.4; }
  .mega__item:hover .mega__title, .mega__item--plain:hover { color: var(--ink); }
  .mega__item:hover, .mega__item:focus-visible { padding-left: 12px; background: var(--yellow-tint); box-shadow: inset 3px 0 0 var(--yellow); }
  .mega__item[aria-current="page"] { box-shadow: inset 2px 0 0 var(--accent); padding-left: 10px; }
  :global(.js) .mega:not([hidden]) { animation: mega-in 0.2s var(--ease); }
  @keyframes mega-in { from { opacity: 0; transform: translateY(-4px); } }

  /* ---- Actions ----------------------------------------------------------- */
  .site-actions { display: flex; align-items: center; gap: 10px; flex: none; }
  .hdr-wa { color: var(--ink); font-weight: 600; }
  .hdr-book { white-space: nowrap; }
  .hdr-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }
  .hdr-icon { transition: background-color 0.2s, color 0.2s; }
  .hdr-icon:hover { background: var(--yellow); color: var(--ink); }
  .hdr-menu {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-width: 44px;
    height: 44px;
    padding: 0 16px;
    border: 0;
    border-radius: 0;
    background: var(--ink);
    color: #fff;
    font: 600 12px/1 var(--font-body);
    letter-spacing: 0.14em;
    cursor: pointer;
  }
  .hdr-menu { transition: background-color 0.2s, color 0.2s, transform 0.25s var(--ease), box-shadow 0.25s; }
  .hdr-menu:hover { background: var(--yellow); color: var(--ink); box-shadow: var(--lift-shadow); }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .hdr-menu:hover { transform: translateY(-2px); }
  }

  /* 900–1139: nav links and every label need ~1100px on one row (1140 leaves
     slack for font metrics), so shed the least-needed labels first. */
  @media (min-width: 900px) and (max-width: 1139px) {
    .hdr-wa { width: 44px; padding: 0; }
    .hdr-wa__label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  }
  @media (min-width: 900px) and (max-width: 999px) {
    .site-actions { gap: 6px; }
    .hdr-book { padding: 0 14px; }
    .hdr-book :global(.hdr-book__arrow) { display: none; }
    .hdr-menu { padding: 0; width: 44px; }
    .hdr-menu__label { display: none; }
  }

  /* ≤640: one tidy row. */
  @media (max-width: 640px) {
    .site-header { gap: 8px; }
    .site-logo { padding-top: 4px; }
    .site-logo img { height: 66px; }
    .site-actions { gap: 8px; }
    .hdr-wa { width: 44px; padding: 0; }
    .hdr-wa__label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .hdr-book { padding: 0 12px; font-size: 13px; }
    .hdr-book :global(.hdr-book__arrow) { display: none; }
    .hdr-search { display: none; }
    .hdr-menu { padding: 0 12px; }
  }
  @media (max-width: 400px) {
    .site-logo { padding-top: 6px; }
    .site-logo img { height: 58px; }
    .hdr-menu { padding: 0; width: 44px; }
    .hdr-menu__label { display: none; }
  }

  /* ---- MENU overlay ------------------------------------------------------ */
  .menu-overlay {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0 var(--gutter) 40px;
    border: 0;
    background: var(--overlay);
    color: #fff;
    overflow: auto;
  }
  .menu-overlay::backdrop { background: var(--overlay); }
  .menu-overlay[open] { display: flex; flex-direction: column; animation: overlay-in 0.25s var(--ease); }
  @keyframes overlay-in { from { opacity: 0; } }
  .menu-overlay__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex: none;
    height: var(--header-h);
    border-bottom: 1px solid var(--overlay-rule);
  }
  .menu-overlay__mark {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    color: #fff;
    font: 700 19px/1 var(--font-display);
    letter-spacing: 0.14em;
    text-decoration: none;
  }
  .menu-overlay__mark span { display: block; width: 14px; height: 14px; background: var(--accent); }
  .menu-overlay__close {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 44px;
    padding: 0 16px;
    border: 0;
    border-radius: 0;
    background: #fff;
    color: var(--ink);
    font: 600 12px/1 var(--font-body);
    letter-spacing: 0.14em;
    cursor: pointer;
  }
  .menu-overlay__close:hover { background: var(--accent); }
  .menu-overlay__body {
    display: grid;
    gap: 40px;
    width: 100%;
    max-width: var(--maxw);
    margin: 40px auto 0;
  }
  @media (min-width: 900px) {
    .menu-overlay__body { grid-template-columns: 1.4fr 1fr; gap: clamp(40px, 6vw, 120px); margin-top: 48px; }
  }
  .menu-overlay__big {
    display: block;
    padding: 6px 0;
    border-bottom: 1px solid var(--overlay-rule);
    color: #fff;
    font: 600 clamp(34px, 4.6vw, 68px)/1.12 var(--font-display);
    letter-spacing: -0.03em;
    text-decoration: none;
  }
  .menu-overlay__big:hover { color: var(--accent); }
  .menu-overlay__big.is-contact { color: var(--accent); border-bottom: 0; }
  .menu-overlay__big.is-contact:hover { color: #fff; }
  .menu-overlay__big[aria-current="page"] { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 10px; }
  .menu-overlay__side { display: grid; align-content: start; gap: 8px; }
  .menu-group { border-bottom: 1px solid var(--overlay-rule); }
  .menu-group summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 52px;
    list-style: none;
    cursor: pointer;
    color: var(--accent);
    font: 600 12px/1 var(--font-body);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .menu-group summary::-webkit-details-marker { display: none; }
  .menu-group :global(.menu-group__icon) { transition: transform 0.25s var(--ease); }
  .menu-group[open] :global(.menu-group__icon) { transform: rotate(45deg); }
  .menu-group ul { display: grid; padding-bottom: 16px; }
  @media (min-width: 480px) {
    .menu-group ul { grid-template-columns: 1fr 1fr; column-gap: 24px; }
  }
  .menu-group a {
    display: flex;
    align-items: center;
    min-height: 44px;
    color: #fff;
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
  }
  .menu-group a:hover, .menu-group a[aria-current="page"] { color: var(--accent); }
  .menu-group__all { text-decoration: underline !important; text-underline-offset: 5px; }
  .menu-overlay__contact { padding-top: 24px; }
  .menu-overlay__ctas { display: flex; flex-wrap: wrap; gap: 12px; }
  .menu-overlay__note { margin-top: 14px; font-size: 13px; color: var(--on-dark-2); }
  .menu-overlay__direct { display: flex; flex-wrap: wrap; gap: 4px 24px; margin-top: 16px; }
  .menu-overlay__direct a { display: inline-flex; align-items: center; min-height: 44px; color: #fff; font-weight: 600; text-decoration: underline; text-underline-offset: 4px; }
  :global(html.is-locked) { overflow: hidden; }

  /* ---- Search ------------------------------------------------------------ */
  .search-dialog {
    width: min(720px, calc(100% - 2 * var(--gutter)));
    max-height: min(80vh, 640px);
    margin: max(12vh, 72px) auto 0;
    padding: 0;
    border: 0;
    border-top: 2px solid var(--ink);
    background: #fff;
    color: var(--ink);
  }
  .search-dialog::backdrop { background: rgb(15 20 22 / 0.55); }
  .search-dialog__form { display: flex; align-items: center; gap: 12px; padding: 12px 12px 12px 20px; border-bottom: 1px solid var(--rule); }
  .search-dialog :global(.search-dialog__glass) { flex: none; color: var(--muted); }
  .search-dialog__input {
    flex: 1;
    min-width: 0;
    min-height: 48px;
    border: 0;
    background: transparent;
    color: var(--ink);
    font: 500 18px/1.3 var(--font-body);
  }
  .search-dialog__input:focus { outline: none; }
  .search-dialog__form:focus-within { box-shadow: inset 0 -2px 0 var(--primary); }
  .search-dialog__status { padding: 12px 20px 0; font-size: 13px; color: var(--muted); }
  .search-dialog__status:empty { display: none; }
  .search-dialog__results { padding: 8px 0 12px; overflow: auto; }
  .search-dialog__results :global(a) {
    display: block;
    padding: 12px 20px;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
  }
  .search-dialog__results :global(a:hover), .search-dialog__results :global(a:focus-visible) { background: #f2f6f6; outline: none; }
  .search-dialog__results :global(.sr-kind) { display: block; font-size: 11px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--primary); }
  .search-dialog__results :global(.sr-title) { display: block; margin-top: 4px; font-weight: 600; }
  .search-dialog__results :global(.sr-desc) { display: block; margin-top: 2px; font-size: 14px; color: var(--muted); }
</style>

<script>
  import { href } from "../lib/url";

  // ---- Desktop mega menus: disclosure buttons, hover on fine pointers --------
  const menus = [...document.querySelectorAll<HTMLElement>("[data-menu]")];
  const parts = (m: HTMLElement) => ({
    trigger: m.querySelector<HTMLButtonElement>("[data-menu-trigger]")!,
    panel: m.querySelector<HTMLElement>("[data-menu-panel]")!,
  });
  const setOpen = (m: HTMLElement, open: boolean) => {
    const { trigger, panel } = parts(m);
    trigger.setAttribute("aria-expanded", String(open));
    panel.hidden = !open;
  };
  const closeAll = () => menus.forEach((m) => setOpen(m, false));
  const canHover = matchMedia("(hover: hover) and (pointer: fine)");
  for (const m of menus) {
    const { trigger } = parts(m);
    let timer: number | undefined;
    trigger.addEventListener("click", () => {
      const open = trigger.getAttribute("aria-expanded") !== "true";
      menus.forEach((o) => setOpen(o, o === m && open));
    });
    m.addEventListener("pointerenter", () => {
      if (!canHover.matches) return;
      clearTimeout(timer);
      timer = window.setTimeout(() => menus.forEach((o) => setOpen(o, o === m)), 90);
    });
    m.addEventListener("pointerleave", () => {
      if (!canHover.matches) return;
      clearTimeout(timer);
      timer = window.setTimeout(() => setOpen(m, false), 200);
    });
    m.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && trigger.getAttribute("aria-expanded") === "true") {
        setOpen(m, false);
        trigger.focus();
      }
    });
    m.addEventListener("focusout", (e) => {
      if (!m.contains(e.relatedTarget as Node | null)) setOpen(m, false);
    });
  }
  document.addEventListener("click", (e) => {
    for (const m of menus) if (!m.contains(e.target as Node)) setOpen(m, false);
  });

  // ---- Modal dialogs (MENU overlay, search) ---------------------------------
  const root = document.documentElement;
  function wireDialog(dialog: HTMLDialogElement, opener: HTMLElement | null, onOpen?: () => void) {
    if (!dialog || !opener) return;
    opener.addEventListener("click", () => {
      closeAll();
      dialog.showModal();
      root.classList.add("is-locked");
      opener.setAttribute("aria-expanded", "true");
      onOpen?.();
    });
    dialog.addEventListener("close", () => {
      root.classList.remove("is-locked");
      opener.setAttribute("aria-expanded", "false");
      opener.focus();
    });
  }

  const menu = document.getElementById("site-menu") as HTMLDialogElement;
  const groups = [...menu.querySelectorAll<HTMLDetailsElement>("[data-menu-group]")];
  const wide = matchMedia("(min-width: 900px)");
  // Groups are open in the HTML (crawlable, no-JS friendly); on phones they
  // start collapsed so the big links come first.
  wireDialog(menu, document.querySelector("[data-menu-open]"), () => {
    groups.forEach((g) => (g.open = wide.matches));
    menu.querySelector<HTMLElement>("[data-menu-close]")?.focus();
  });
  menu.querySelector("[data-menu-close]")!.addEventListener("click", () => menu.close());
  menu.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("a")) menu.close();
  });

  // ---- Search ------------------------------------------------------------------
  type Entry = { title: string; description: string; url: string; kind: string; keywords?: string };
  const search = document.getElementById("site-search") as HTMLDialogElement;
  const input = search.querySelector<HTMLInputElement>("input[type=search]")!;
  const list = search.querySelector<HTMLUListElement>("[data-search-results]")!;
  const status = search.querySelector<HTMLElement>("[data-search-status]")!;
  let index: Entry[] | null = null;
  let loading: Promise<Entry[]> | null = null;
  const load = () =>
    (loading ??= fetch(href("/search.json"))
      .then((r) => (r.ok ? r.json() : []))
      .then((d: Entry[]) => (index = d))
      .catch(() => (index = [])));
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c]!);
  const render = () => {
    const q = input.value.trim().toLowerCase();
    list.innerHTML = "";
    if (!q) {
      status.textContent = "";
      return;
    }
    if (!index) {
      status.textContent = "Loading…";
      return;
    }
    const terms = q.split(/\s+/);
    const scored = index
      .map((e) => {
        const title = e.title.toLowerCase();
        const hay = `${title} ${e.description.toLowerCase()} ${e.kind.toLowerCase()} ${(e.keywords ?? "").toLowerCase()}`;
        if (!terms.every((t) => hay.includes(t))) return null;
        const score = terms.reduce((s, t) => s + (title.includes(t) ? 3 : 1), 0) + (title.startsWith(terms[0]) ? 2 : 0);
        return { e, score };
      })
      .filter((x): x is { e: Entry; score: number } => x !== null)
      .sort((a, b) => b.score - a.score)
      .slice(0, 10);
    status.textContent = scored.length ? `${scored.length} result${scored.length === 1 ? "" : "s"}` : "No matches. Try another word, or contact us.";
    list.innerHTML = scored
      .map(
        ({ e }) =>
          `<li><a href="${esc(e.url)}"><span class="sr-kind">${esc(e.kind)}</span><span class="sr-title">${esc(e.title)}</span><span class="sr-desc">${esc(e.description)}</span></a></li>`
      )
      .join("");
  };
  wireDialog(search, document.querySelector("[data-search-open]"), () => {
    input.focus();
    load().then(render);
  });
  input.addEventListener("input", render);
  search.querySelector("[data-search-form]")!.addEventListener("submit", (e) => {
    e.preventDefault();
    list.querySelector("a")?.click();
  });
  search.querySelector("[data-search-close]")!.addEventListener("click", () => search.close());
  search.addEventListener("click", (e) => {
    if (e.target === search) search.close();
  });
</script>
