---
// Job application: one free Tally form embedded on every role page, with the
// role title passed in its hidden "position" field. Tally enforces the required
// fields, the PDF-only rule and the size limit, and shows the reCAPTCHA. The
// email line stays visible in case the embed is blocked. Without a form ID the
// page only asks applicants to email HR.
import { CAREERS_PAGE } from "../data/copy";
import { SITE } from "../data/site";
import { href } from "../lib/url";

interface Props {
  position: string;
}
const { position } = Astro.props;
const f = CAREERS_PAGE.form;
const formId = import.meta.env.PUBLIC_TALLY_CAREERS_FORM_ID as string | undefined;
const embed = formId
  ? `https://tally.so/embed/${encodeURIComponent(formId)}?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1&position=${encodeURIComponent(position)}`
  : undefined;
---
<div class="af">
  {embed && (
    <>
      <p class="af__note">{f.resumeNote}</p>
      <iframe class="af__embed" data-tally-src={embed} data-tally-form={formId} loading="lazy" width="100%" height="620" title={f.embedTitle}></iframe>
    </>
  )}
  <p class="af__note">{embed ? f.fallback : f.emailOnly} <a class="link" href={`mailto:${SITE.emailHr}`}>{SITE.emailHr}</a>.</p>
  <p class="af__note">{f.privacy} <a class="link" href={href("/privacy/")}>{f.privacyLink}</a>.</p>
</div>

<style>
  .af { display: grid; grid-template-columns: minmax(0, 1fr); gap: 14px; }
  .af__embed { width: 100%; border: 0; vertical-align: top; }
  /* Without JavaScript the embed can't load, so the email line stands alone. */
  :global(html:not(.js)) .af__embed { display: none; }
  .af__note { max-width: 62ch; font-size: 14px; line-height: 1.55; color: var(--muted); }
  /* Inline link: vertical padding grows the tap target to 44px. */
  .af__note a { padding-block: 13px; }
</style>

<script>
  import { showThankYou } from "../scripts/thank-you";

  const TALLY_ORIGIN = "https://tally.so";
  const iframe = document.querySelector<HTMLIFrameElement>("iframe[data-tally-src]");

  if (iframe) {
    // Tally's script loads as the visitor nears the form, so role pages stay light
    // and nobody who only reads the description contacts Tally.
    const load = () => {
      const script = document.createElement("script");
      script.src = `${TALLY_ORIGIN}/widgets/embed.js`;
      script.async = true;
      script.onload = () => (window as unknown as { Tally?: { loadEmbeds(): void } }).Tally?.loadEmbeds();
      script.onerror = () => {
        iframe.hidden = true;
      };
      document.head.append(script);
    };
    new IntersectionObserver((entries, observer) => {
      if (!entries.some((entry) => entry.isIntersecting)) return;
      observer.disconnect();
      load();
    }, { rootMargin: "800px" }).observe(iframe);

    // The event carries the applicant's answers: read only the form ID, and never
    // log or forward the message.
    window.addEventListener("message", (e) => {
      if (e.origin !== TALLY_ORIGIN || e.source !== iframe.contentWindow) return;
      if (typeof e.data !== "string" || !e.data.includes("Tally.FormSubmitted")) return;
      try {
        if (JSON.parse(e.data)?.payload?.formId === iframe.dataset.tallyForm) showThankYou("careers");
      } catch {
        // Not a Tally event after all.
      }
    });
  }
</script>
