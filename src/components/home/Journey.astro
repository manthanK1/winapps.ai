---
// Home "Our Journey": headline figures and award badges beside a consultation
// button that jumps to the form at the top of the footer (#contact).
import { Image } from "astro:assets";
import Icon from "../Icon.astro";
import { HOME } from "../../data/copy";
import awardDark from "../../assets/images/awards/award_dark.svg";
import globeeAward from "../../assets/images/awards/globee_award_dark.svg";
import incAward from "../../assets/images/awards/inc_award_dark.svg";
import stevieAward from "../../assets/images/awards/stevie_award_dark.svg";

const { journey } = HOME;
const awards = [
  { image: stevieAward, alt: "2023 Stevie Winner", text: "Achievement in Customer Satisfaction 2024" },
  { image: incAward, alt: "2023 Inc. 5000", text: "America's Fastest-growing Companies 2023" },
  { image: awardDark, alt: "2023 IAOP Global Outsourcing 100", text: "Top 100 Global Outsourcing Providers 2023" },
  { image: globeeAward, alt: "Globee Awards", text: "Best IT Service Provider of the Year 2025" },
];
---
<section class="section" aria-labelledby="journey-title">
  <div class="container journey">
    <div class="journey__content veil">
      <h2 id="journey-title" class="h2">{journey.title}</h2>
      <p class="lead journey__lead">{journey.lead}</p>
      <a href="#contact" class="btn btn--dark">{journey.cta} <Icon name="arrow" size={18} class="arrow" /></a>
    </div>

    <div class="journey__proof">
      <div class="journey__stats veil">
        {journey.stats.map((s) => (
          <div>
            <span class="journey__number">{s.number}</span>
            <span class="journey__label">{s.label}</span>
          </div>
        ))}
      </div>
      <ul class="list-reset journey__awards">
        {awards.map((a) => (
          <li class="award">
            <div class="award__badge">
              <Image src={a.image} alt={a.alt} width={120} height={70} loading="lazy" decoding="async" class="award__img" />
            </div>
            <p class="award__text">{a.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .journey { display: grid; gap: 48px; }
  @media (min-width: 1024px) {
    .journey { grid-template-columns: 1fr 1fr; align-items: center; gap: 64px; }
  }
  .journey__lead { margin-block: 20px 32px; }
  .journey__proof { display: grid; gap: 32px; }
  .journey__stats { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .journey__number { font-size: clamp(2.5rem, 4vw, 3.5rem); font-weight: 800; line-height: 1; color: var(--ink); }
  .journey__label { display: block; margin-top: 8px; font-size: 0.875rem; color: var(--ink-2); }
  .journey__awards { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
  .award { padding: 20px; border: 1px solid var(--rule); background: #fff; text-align: center; }
  .award__badge { display: flex; align-items: center; justify-content: center; height: 70px; margin-bottom: 12px; }
  .award__img { width: auto; max-height: 60px; object-fit: contain; }
  .award__text { font-size: 0.8rem; line-height: 1.3; color: var(--ink-2); }
</style>
