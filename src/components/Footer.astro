---
// Footer in the design's language (1px ink rule, near-white panel, 13px
// meta row) carrying all of V1's columns: Services, Training, Explore,
// Company, Legal, Social, then every contact route as one strip of equal
// cells (so the brand column and the link columns come out the same height).
import Icon from "./Icon.astro";
import { EMAILS, FOOTER, SITE, SOCIAL } from "../data/site";
import { TRAINING_PAGE } from "../data/copy";
import { AUDIENCES, getServices } from "../lib/content";
import { href } from "../lib/url";

const services = await getServices();
const year = new Date().getFullYear();
const contacts = [
  ...EMAILS.map((e) => ({ icon: "mail" as const, label: e.label, value: e.address, href: `mailto:${e.address}`, external: false })),
  { icon: "phone" as const, label: "Phone", value: SITE.phone, href: SITE.phoneHref, external: false },
  { icon: "whatsapp" as const, label: "WhatsApp", value: "Chat with us", href: SITE.whatsappHref, external: true },
];
---
<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <a href={href("/")} class="site-footer__logo" aria-label={`${SITE.name} home`}>
          <picture>
            <source srcset={href("/brand/winapps-logo-still.webp")} type="image/webp" media="(prefers-reduced-motion: reduce)" />
            <img src={href("/brand/winapps-logo.gif")} alt={SITE.name} width="257" height="287" loading="lazy" decoding="async" />
          </picture>
        </a>
        <p class="site-footer__legal">{SITE.legalName}</p>
        <p class="site-footer__blurb">{FOOTER.blurb}</p>
      </div>

      <nav class="site-footer__cols" aria-label="Footer">
        <div>
          <h2 class="site-footer__head">Services</h2>
          <ul class="list-reset">
            {services.map((s) => <li><a href={href(`/services/${s.id}/`)}>{s.data.title}</a></li>)}
          </ul>
        </div>
        <div>
          <h2 class="site-footer__head">Training</h2>
          <ul class="list-reset">
            {AUDIENCES.map((a) => <li><a href={href(`/training/#${a}`)}>{TRAINING_PAGE.audiences[a].label}</a></li>)}
            <li><a href={href("/training/#short-courses")}>{TRAINING_PAGE.shortCourses.title}</a></li>
            <li><a href={href("/training/")}>All training</a></li>
          </ul>
        </div>
        <div>
          <h2 class="site-footer__head">Explore</h2>
          <ul class="list-reset">
            {FOOTER.explore.map((l) => <li><a href={href(l.href)}>{l.label}</a></li>)}
          </ul>
        </div>
        <div>
          <h2 class="site-footer__head">Company</h2>
          <ul class="list-reset">
            {FOOTER.company.map((l) => <li><a href={href(l.href)}>{l.label}</a></li>)}
          </ul>
          <h2 class="site-footer__head site-footer__head--gap">Legal</h2>
          <ul class="list-reset">
            {FOOTER.legal.map((l) => <li><a href={href(l.href)}>{l.label}</a></li>)}
          </ul>
        </div>
        <div>
          <h2 class="site-footer__head">Social</h2>
          <ul class="list-reset">
            {SOCIAL.map((s) => <li><a href={s.href} target="_blank" rel="noopener">{s.label}</a></li>)}
          </ul>
        </div>
      </nav>
    </div>

    <address class="site-footer__contact">
      {contacts.map((c) => (
        <a class="site-footer__route" href={c.href} {...(c.external ? { target: "_blank", rel: "noopener" } : {})}>
          <Icon name={c.icon} size={20} />
          <span class="site-footer__route-text">
            <span class="site-footer__route-label">{c.label}</span>
            {/* An address may wrap at "@" if it must, never mid-word. */}
            <span>{c.icon === "mail" ? <>{c.value.split("@")[0]}<wbr />@{c.value.split("@")[1]}</> : c.value}</span>
          </span>
        </a>
      ))}
    </address>

    <div class="site-footer__bar">
      <p>© {SITE.founded}–{year} {SITE.name}®. All rights reserved.</p>
      <p>{SITE.legalName} · <a href={`mailto:${SITE.email}`}>{SITE.email}</a> · <a href={SITE.phoneHref}>{SITE.phone}</a></p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    z-index: 1;
    margin-top: clamp(48px, 8vw, 120px);
    border-top: 1px solid var(--ink);
    background-color: var(--paper);
    /* The site grid, subtle, with one soft glow: the footer is opaque, so it carries its own. */
    background-image:
      radial-gradient(45% 90% at 90% 100%, rgb(var(--depth-gold-rgb) / 0.1), transparent 70%),
      radial-gradient(40% 80% at 5% 0%, rgb(var(--depth-grid-rgb) / 0.07), transparent 70%),
      linear-gradient(rgb(var(--depth-grid-rgb) / 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgb(var(--depth-grid-rgb) / 0.06) 1px, transparent 1px);
    background-size: auto, auto, var(--depth-grid-cell) var(--depth-grid-cell), var(--depth-grid-cell) var(--depth-grid-cell);
    background-position: 0 0, 0 0, center top, center top;
    color: var(--ink);
  }
  .site-footer__grid {
    display: grid;
    gap: 48px;
    padding-block: clamp(48px, 6vw, 80px) 48px;
  }
  @media (min-width: 1100px) {
    .site-footer__grid { grid-template-columns: minmax(260px, 1fr) 2.6fr; gap: 64px; }
  }
  .site-footer__logo { display: inline-flex; height: 64px; overflow: hidden; }
  .site-footer__logo img { height: 72px; width: auto; max-width: none; }
  .site-footer__legal { margin-top: 12px; font: 600 18px/1.25 var(--font-display); letter-spacing: -0.01em; }
  .site-footer__blurb { margin-top: 10px; max-width: 34ch; font-size: 14px; color: var(--ink-2); }
  /* Contact strip: equal cells split by 1px rules (the list colour shows
     through the gaps), like the home commitments row. */
  .site-footer__contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1px;
    margin-bottom: 48px;
    border-block: 1px solid var(--rule-2);
    background: var(--rule-2);
    font-style: normal;
  }
  /* Mid widths: the three emails on one row, phone and WhatsApp on the next. */
  @media (min-width: 560px) and (max-width: 1279px) {
    .site-footer__contact { grid-template-columns: repeat(6, minmax(0, 1fr)); }
    .site-footer__route { grid-column: span 2; }
    .site-footer__route:nth-child(n + 4) { grid-column: span 3; }
  }
  @media (min-width: 1280px) {
    .site-footer__contact { grid-template-columns: repeat(5, minmax(0, 1fr)); }
  }
  .site-footer__route {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 76px;
    padding: 14px clamp(14px, 1.6vw, 24px);
    background: #fff;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.2s, box-shadow 0.2s;
  }
  /* Narrow cells: the icon sits above the text to leave the address room. */
  @media (min-width: 560px) and (max-width: 899px) {
    .site-footer__route { flex-direction: column; align-items: flex-start; gap: 8px; padding-block: 16px; }
  }
  .site-footer__route:hover { background: var(--yellow-tint); box-shadow: inset 0 3px 0 var(--yellow); }
  .site-footer__route :global(svg) { flex: none; color: var(--primary); }
  .site-footer__route-text { display: grid; gap: 2px; line-height: 1.3; }
  .site-footer__route-label { font-size: 11px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .site-footer__cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 36px 24px;
  }
  @media (min-width: 720px) {
    .site-footer__cols { grid-template-columns: repeat(5, minmax(0, 1fr)); }
  }
  .site-footer__head {
    margin-bottom: 10px;
    font: 600 12px/1.3 var(--font-body);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--primary);
  }
  .site-footer__head--gap { margin-top: 28px; }
  .site-footer__cols a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 14px;
    color: var(--ink-2);
    text-decoration: none;
  }
  @media (min-width: 1100px) {
    .site-footer__cols a { min-height: 36px; }
  }
  .site-footer__cols a:hover { color: var(--primary); text-decoration: underline; text-underline-offset: 4px; }
  .site-footer__bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding: 20px 0 28px;
    border-top: 1px solid var(--ink);
    font-size: 13px;
    color: var(--ink-2);
  }
  .site-footer__bar a { color: inherit; }
</style>
