---
// The social networks' own logos in their brand colours, so unlike Icon.astro
// they are filled and do not follow the text colour. Decorative: the link text
// next to each one names it. Render each logo once per page (the Instagram
// gradient has a fixed id).
export type SocialLogoName = "linkedin" | "instagram" | "facebook";

interface Props {
  name: SocialLogoName;
  size?: number;
}
const { name, size = 20 } = Astro.props;
---
<svg class="social-logo" width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {name === "linkedin" && (
    <>
      <rect x="1" y="1" width="22" height="22" fill="#fff" />
      <path fill="#0A66C2" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
    </>
  )}
  {name === "instagram" && (
    <>
      <defs>
        <radialGradient id="social-logo-instagram" cx="0.27" cy="1.05" r="1.15">
          <stop offset="0" stop-color="#FFDD55" />
          <stop offset="0.3" stop-color="#FF8A3D" />
          <stop offset="0.55" stop-color="#FF3D5E" />
          <stop offset="0.8" stop-color="#C837AB" />
          <stop offset="1" stop-color="#5B4FE9" />
        </radialGradient>
      </defs>
      <rect width="24" height="24" rx="6" fill="url(#social-logo-instagram)" />
      <rect x="4.5" y="4.5" width="15" height="15" rx="4.5" fill="none" stroke="#fff" stroke-width="1.8" />
      <circle cx="12" cy="12" r="3.6" fill="none" stroke="#fff" stroke-width="1.8" />
      <circle cx="16.6" cy="7.4" r="1.1" fill="#fff" />
    </>
  )}
  {name === "facebook" && (
    <>
      <circle cx="12" cy="12" r="11" fill="#fff" />
      <path fill="#0866FF" d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z" />
    </>
  )}
</svg>
