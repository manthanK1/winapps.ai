---
// Technology we use in production (V1 TechStack): four groups under a thin
// ink rule, each an eyebrow-style label and a list of tools.
import { STACK } from "../data/site";
---
<dl class="stack">
  {Object.entries(STACK).map(([group, items]) => (
    <div class="stack__group veil">
      <dt class="stack__label">{group}</dt>
      <dd>
        <ul class="stack__list">
          {items.map((t) => <li>{t}</li>)}
        </ul>
      </dd>
    </div>
  ))}
</dl>

<style>
  .stack {
    display: grid;
    gap: 40px;
    padding-top: 40px;
    border-top: 1px solid var(--ink);
  }
  @media (min-width: 640px) {
    .stack { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1024px) {
    .stack { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  .stack__label {
    font-size: 12px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--primary);
  }
  .stack__list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.015em;
  }
</style>
