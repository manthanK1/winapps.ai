---
const lookerUrl = import.meta.env.PUBLIC_LOOKER_STUDIO_EMBED_URL || "";
const ga4Url = import.meta.env.PUBLIC_GA4_DASHBOARD_URL || "https://analytics.google.com/";
const clarityUrl = import.meta.env.PUBLIC_CLARITY_DASHBOARD_URL || "https://clarity.microsoft.com/";
const web3formsUrl = import.meta.env.PUBLIC_WEB3FORMS_DASHBOARD_URL || "https://app.web3forms.com/";
const careersSheetUrl = import.meta.env.PUBLIC_CAREERS_SHEET_URL || "https://docs.google.com/spreadsheets/";

const quickLinks = [
  {
    title: "GA4 Realtime",
    subtitle: "Live visitors, active pages & real-time events",
    href: ga4Url,
  },
  {
    title: "Microsoft Clarity",
    subtitle: "Session recordings & click/scroll heatmaps",
    href: clarityUrl,
  },
  {
    title: "Web3Forms Inbox",
    subtitle: "View & manage submitted contact & footer forms",
    href: web3formsUrl,
  },
  {
    title: "Careers Google Sheet",
    subtitle: "All job applications & candidate submissions",
    href: careersSheetUrl,
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin Dashboard | Internal</title>
    <style>
      :root {
        --bg-main: #0b0f17;
        --bg-header: #0d131f;
        --bg-card: #111827;
        --bg-card-hover: #162033;
        --border-subtle: #1e293b;
        --border-hover: #334155;
        --text-primary: #f8fafc;
        --text-secondary: #94a3b8;
        --text-muted: #64748b;
        --accent-teal: #2dd4bf;
        --accent-blue-bg: rgba(23, 37, 84, 0.7);
        --accent-blue-text: #93c5fd;
        --accent-blue-border: rgba(30, 64, 175, 0.65);
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      body {
        min-height: 100vh;
        background-color: var(--bg-main);
        color: var(--text-primary);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Inter, sans-serif;
        -webkit-font-smoothing: antialiased;
        display: flex;
        flex-direction: column;
      }

      a {
        text-decoration: none;
        color: inherit;
      }

      .container {
        width: 100%;
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 24px;
      }

      /* Top Header */
      .topbar {
        position: sticky;
        top: 0;
        z-index: 20;
        background-color: rgba(13, 19, 31, 0.92);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid var(--border-subtle);
      }

      .topbar-inner {
        height: 64px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
      }

      .brand {
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .brand-logo {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        background: rgba(45, 212, 191, 0.14);
        border: 1px solid rgba(45, 212, 191, 0.35);
        color: var(--accent-teal);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 14px;
      }

      .brand-name {
        font-size: 15px;
        font-weight: 600;
        color: var(--text-primary);
      }

      .brand-sep {
        color: var(--text-muted);
      }

      .brand-sub {
        font-size: 12px;
        font-weight: 500;
        color: var(--text-secondary);
      }

      .topbar-actions {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .status-pill {
        display: inline-flex;
        align-items: center;
        padding: 5px 12px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 500;
        background: var(--accent-blue-bg);
        color: var(--accent-blue-text);
        border: 1px solid var(--accent-blue-border);
      }

      .back-btn {
        padding: 7px 14px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 500;
        color: #cbd5e1;
        background: #1e293b;
        border: 1px solid #334155;
        transition: all 0.15s ease;
      }

      .back-btn:hover {
        color: #ffffff;
        background: #273549;
      }

      /* Main Area */
      main {
        flex: 1;
        padding-top: 32px;
        padding-bottom: 48px;
      }

      .page-header {
        padding-bottom: 24px;
        border-bottom: 1px solid var(--border-subtle);
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 16px;
        margin-bottom: 28px;
      }

      .page-title {
        font-size: 24px;
        font-weight: 700;
        letter-spacing: -0.02em;
        color: var(--text-primary);
      }

      .page-subtitle {
        margin-top: 6px;
        font-size: 14px;
        color: var(--text-secondary);
      }

      .section-label {
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-secondary);
        margin-bottom: 14px;
      }

      /* Quick Links Grid */
      .cards-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 32px;
      }

      @media (max-width: 1024px) {
        .cards-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      @media (max-width: 600px) {
        .cards-grid {
          grid-template-columns: 1fr;
        }
        .hide-mobile {
          display: none;
        }
      }

      .card {
        background: var(--bg-card);
        border: 1px solid var(--border-subtle);
        border-radius: 12px;
        padding: 20px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transition: background-color 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
        cursor: pointer;
      }

      .card:hover {
        background: var(--bg-card-hover);
        border-color: var(--border-hover);
        transform: translateY(-2px);
      }

      .card-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
      }

      .card-title {
        font-size: 16px;
        font-weight: 600;
        color: var(--text-primary);
        transition: color 0.15s ease;
      }

      .card:hover .card-title {
        color: var(--accent-teal);
      }

      .card-arrow {
        font-size: 14px;
        color: var(--text-secondary);
        transition: color 0.15s ease, transform 0.15s ease;
      }

      .card:hover .card-arrow {
        color: var(--accent-teal);
        transform: translate(2px, -2px);
      }

      .card-desc {
        margin-top: 8px;
        font-size: 13px;
        line-height: 1.5;
        color: var(--text-secondary);
      }

      /* Looker Studio Panel */
      .report-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 14px;
      }

      .report-status {
        font-size: 12px;
        color: var(--text-muted);
      }

      .report-box {
        background: var(--bg-card);
        border: 1px solid var(--border-subtle);
        border-radius: 12px;
        overflow: hidden;
      }

      .report-iframe {
        width: 100%;
        height: 660px;
        border: 0;
        display: block;
      }

      .empty-state {
        padding: 68px 24px;
        text-align: center;
      }

      .empty-title {
        font-size: 16px;
        font-weight: 600;
        color: #e2e8f0;
      }

      .empty-desc {
        margin: 10px auto 0;
        max-width: 600px;
        font-size: 13px;
        line-height: 1.6;
        color: var(--text-secondary);
      }

      .code-pill {
        display: inline-block;
        padding: 2px 8px;
        border-radius: 6px;
        background: #1e293b;
        border: 1px solid #334155;
        color: #e2e8f0;
        font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
        font-size: 12px;
      }

      /* Footer */
      footer {
        border-top: 1px solid var(--border-subtle);
        padding: 20px 0;
        font-size: 12px;
        color: var(--text-muted);
      }

      .footer-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
      }
    </style>
  </head>
  <body>
    <header class="topbar">
      <div class="container topbar-inner">
        <div class="brand">
          <div class="brand-logo">W</div>
          <span class="brand-name">Winapps</span>
          <span class="brand-sep">/</span>
          <span class="brand-sub">Admin Console</span>
        </div>

        <div class="topbar-actions">
          <span class="status-pill hide-mobile">cPanel Protected • noindex</span>
          <a href="/" class="back-btn">← Back to Site</a>
        </div>
      </div>
    </header>

    <main class="container">
      <div class="page-header">
        <div>
          <h1 class="page-title">Analytics &amp; Operations</h1>
          <p class="page-subtitle">
            Privacy-first GA4 overview (country/city level, zero IP storage)
          </p>
        </div>
        <span class="status-pill">cPanel Protected • noindex</span>
      </div>

      <section aria-labelledby="quick-links-title">
        <h2 id="quick-links-title" class="section-label">Quick Links</h2>
        <div class="cards-grid">
          {quickLinks.map((item) => (
            <a
              href={item.href}
              target="_blank"
              rel="noopener noreferrer"
              class="card"
            >
              <div class="card-top">
                <h3 class="card-title">{item.title}</h3>
                <span class="card-arrow">↗</span>
              </div>
              <p class="card-desc">{item.subtitle}</p>
            </a>
          ))}
        </div>
      </section>

      <section aria-labelledby="looker-title">
        <div class="report-header">
          <h2 id="looker-title" class="section-label" style="margin-bottom: 0;">
            GA4 Looker Studio Report
          </h2>
          <span class="report-status">
            {lookerUrl ? "Live Embed Connected" : "Awaiting .env URL"}
          </span>
        </div>

        <div class="report-box">
          {lookerUrl ? (
            <iframe
              src={lookerUrl}
              class="report-iframe"
              allowfullscreen
              sandbox="allow-storage-access-by-user-activation allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox"
              title="Winapps GA4 Looker Studio Report"
            />
          ) : (
            <div class="empty-state">
              <p class="empty-title">Looker Studio Report URL not configured yet</p>
              <p class="empty-desc">
                Set <code class="code-pill">PUBLIC_LOOKER_STUDIO_EMBED_URL</code> in your{" "}
                <code class="code-pill">.env</code> file to display visitors, traffic sources, top pages, conversions, and device split.
              </p>
            </div>
          )}
        </div>
      </section>
    </main>

    <footer>
      <div class="container footer-inner">
        <span>Winapps Internal Operations Console</span>
        <span>Excluded from sitemap &amp; search indexing</span>
      </div>
    </footer>
  </body>
</html>